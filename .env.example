# CoachBot configuration. Copy to .env and fill in. Never commit .env.
# .NET maps "__" to config sections (e.g. Coros__Mode -> Coros:Mode). Real environment variables override .env.

# --- Database (Supabase Postgres) ---------------------------------------------
# Local (`supabase start`):            Host=127.0.0.1;Port=54322;Database=postgres;Username=postgres;Password=postgres
# Local, app running in Docker:        put Host=host.docker.internal;Port=54322;… in .env.docker (container-only override)
# Hosted Supabase (session pooler, IPv4, port 5432 — NOT the 6543 transaction pooler):
#   Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<db-password>;SSL Mode=Require;Trust Server Certificate=false
ConnectionStrings__Postgres=Host=127.0.0.1;Port=54322;Database=postgres;Username=postgres;Password=postgres

# --- Secrets --------------------------------------------------------------------
# 32 random bytes, base64. Encrypts COROS OAuth tokens at rest. Generate: openssl rand -base64 32
# Changing it invalidates stored COROS tokens (just run /connect again).
Secrets__EncryptionKey=

# --- Coach ----------------------------------------------------------------------
Coach__TimeZone=Asia/Ho_Chi_Minh
# en | vi — language of messages, reports and AI analysis
Coach__Language=en
# Only needed for the browser-based COROS login fallback (PKCE redirect target).
Coach__PublicBaseUrl=http://localhost:8080
Coach__PushWindowDays=7

# --- COROS ----------------------------------------------------------------------
# mock = synthetic data (default, no account needed) | mcp = official COROS MCP server
Coros__Mode=mock
# Regional endpoints: https://mcp.coros.com/mcp (global), mcpeu / mcpus / mcpcn.coros.com/mcp
Coros__McpUrl=https://mcp.coros.com/mcp
# Mock scenarios: normal | fatigued | missing_hrv | sparse_history
Coros__MockScenario=normal
# Push approved workouts to the COROS calendar automatically. Keep false until `coros test-write` worked for you.
Coros__EnableWorkoutPush=false

# --- LLM ------------------------------------------------------------------------
# none (rule-based templates only) | gemini | openai_compatible
Llm__Provider=none
Llm__Model=gemini-flash-latest
Llm__ApiKey=
# Only for openai_compatible (e.g. https://api.openai.com/v1, http://localhost:11434/v1)
Llm__BaseUrl=
# Seconds per attempt; plan design with structured workouts is a long answer
Llm__TimeoutSeconds=150

# --- Telegram -------------------------------------------------------------------
# From @BotFather. Leave empty to run without the bot (jobs still run, messages are logged only).
Telegram__BotToken=
# Your chat id. Leave empty on first run: send /start and the bot replies with the id to put here.
Telegram__AllowedChatId=

# --- Schedules (cron, interpreted in Coach__TimeZone) ---------------------------
Jobs__SyncCron=0 */3 * * *
Jobs__DailyCheckCron=30 6 * * *
Jobs__WeeklyReportCron=0 19 * * 0
Jobs__PushCron=0 20 * * *
Jobs__ExpiryCron=15 * * * *
